{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Studio Helper registry",
  "description": "SPEC.md §6.1. Unknown keys anywhere in this document are an error.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "formats"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "print_defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bleed_mm": { "type": "number", "minimum": 0 },
        "safe_mm": { "type": "number", "minimum": 0 },
        "pdf_preset": { "type": "string", "minLength": 1 },
        "raster_ppi": { "type": "number", "exclusiveMinimum": 0 },
        "min_image_ppi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "warn": { "type": "number", "exclusiveMinimum": 0 },
            "fail": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "tiff_if_longest_side_mm_over": { "type": "number", "exclusiveMinimum": 0 },
        "tiff_ppi": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/format" }
    },
    "job_types": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h", "unit"],
      "properties": {
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "enum": ["mm", "px"] }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h"],
      "properties": {
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "exports"],
      "oneOf": [
        { "required": ["size"] },
        { "required": ["panels", "unit"] }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "kebab-case, unique"
        },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["print", "screen", "web", "social"] },
        "size": { "$ref": "#/$defs/size" },
        "panels": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/panel" }
        },
        "panel_gap_mm": { "type": "number", "minimum": 0 },
        "unit": {
          "type": "string",
          "enum": ["mm", "px"],
          "description": "required alongside panels, since panel entries have no unit of their own"
        },
        "bleed_mm": { "type": "number", "minimum": 0 },
        "safe_mm": { "type": "number", "minimum": 0 },
        "safe_px": { "type": "number", "minimum": 0 },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "exports": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["pdf", "tiff", "png", "jpg", "mp4"] }
        },
        "allow_alpha": { "type": "boolean" },
        "max_kb": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
